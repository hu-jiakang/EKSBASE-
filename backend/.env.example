# Application; never commit a production .env file.
PORT=3000
NODE_ENV=production

# Kingdee LoginByAppSecret integration
KINGDEE_ENABLED=false
KINGDEE_BASE_URL=
KINGDEE_ERP_ACCOUNT=
KINGDEE_INTEGRATION_USERNAME=
KINGDEE_APP_ID=
KINGDEE_APP_SECRET=
KINGDEE_LANGUAGE_ID=2052
KINGDEE_ORGANIZATION=

# Serial database currently uses backend/data/kingdee.db in database.js.
# AUTH_DATABASE_PATH is honored by authDatabase.js.
DATABASE_PATH=./data/kingdee.db
AUTH_DATABASE_PATH=./data/eksbase-auth.db

# DingTalk SSO
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=

# Dedicated ADMIN login disabled until this is configured securely.
EKSBASE_ADMIN_PASSWORD=
# Optional secure temporary password for the manual reset script.
EKSBASE_INITIAL_PASSWORD=
